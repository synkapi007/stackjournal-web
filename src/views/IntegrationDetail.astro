---
import { Icon } from 'astro-icon/components';
import Section from '../components/Section.astro';
import { site } from '../config/site';
import { getI18n } from '../i18n/context';
import Layout from '../layouts/Layout.astro';
import type { Integration } from '../lib/integrations';
import { renderMarkdown } from '../lib/markdown';
import { asset } from '../lib/urls';

interface Props {
  integration: Integration;
}

const { integration } = Astro.props;
const { t, path } = getI18n(Astro.currentLocale);
const html = await renderMarkdown(integration.body, { dropTitle: true });
const image = integration.screenshot ? asset(integration.screenshot, import.meta.env.BASE_URL) : undefined;
---

<Layout title={integration.name} description={integration.description}>
  <Section last>
    <nav aria-label={t('integrations.breadcrumb')} class="mb-8 flex items-center gap-2 font-mono text-xs text-muted">
      <a href={path('/integrations')} class="hover:text-fg">
        {t('nav.integrations')}
      </a>
      <span aria-hidden="true" class="text-outline">
        /
      </span>
      <span aria-current="page" class="text-fg">
        {integration.name}
      </span>
    </nav>

    <div class="flex flex-col justify-between gap-6 border-b border-hairline pb-10 md:flex-row md:items-end">
      <div class="space-y-3">
        <p class="eyebrow">{t(`category.${integration.category}`)}</p>
        <h1 class="flex items-center gap-3 font-serif text-3xl text-fg sm:text-4xl">
          <Icon name={integration.icon} class="size-7 shrink-0 text-accent" aria-hidden="true" />
          {t('integrations.pageTitle', { name: integration.name })}
        </h1>
        <p class="max-w-xl text-sm text-muted">{integration.description}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={integration.homepage}
          class="flex items-center gap-1.5 rounded border border-outline px-3 py-1.5 font-mono text-xs text-fg transition-colors hover:border-accent"
        >
          {t('integrations.homepage')}
          <Icon name="lucide:arrow-up-right" class="size-3" aria-hidden="true" />
        </a>
        <a
          href={site.repository}
          class="flex items-center gap-1.5 rounded border border-outline px-3 py-1.5 font-mono text-xs text-fg transition-colors hover:border-accent"
        >
          <Icon name="simple-icons:github" class="size-3" aria-hidden="true" />
          {t('nav.github')}
        </a>
      </div>
    </div>

    {image && <img src={image} alt={integration.name} class="mt-10 w-full rounded border border-hairline" />}

    {html && <article class="prose mt-10 max-w-2xl" set:html={html} />}
  </Section>
</Layout>

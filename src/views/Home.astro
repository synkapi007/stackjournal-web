---
import { Icon } from 'astro-icon/components';
import CopyStatus from '../components/CopyStatus.astro';
import CtaBox from '../components/CtaBox.astro';
import InstallTabs from '../components/InstallTabs.astro';
import IntegrationCard from '../components/IntegrationCard.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TerminalMock from '../components/TerminalMock.astro';
import { site } from '../config/site';
import { getI18n } from '../i18n/context';
import Layout from '../layouts/Layout.astro';
import { getIntegrations, type Integration } from '../lib/integrations';
import { getCtas } from '../lib/ctas';

interface Props {
  items?: Integration[];
}

const { locale, t, path } = getI18n(Astro.currentLocale);
const hero = site.hero[locale];
const ctas = getCtas(locale, import.meta.env.BASE_URL);
const integrations = Astro.props.items ?? getIntegrations(locale);
const featured = integrations.filter(item => item.featured);
---

<Layout>
  <Section class="pt-14 sm:pt-20">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="space-y-8 lg:col-span-6">
        <p class="inline-flex items-center gap-2 rounded border border-hairline bg-raised px-2.5 py-1 font-mono text-xs text-muted">
          <span class="size-1.5 rounded-full bg-success"></span>
          {site.name} v{site.version}
        </p>
        <div class="space-y-4">
          <h1 class="font-serif text-4xl leading-[1.08] tracking-tight text-fg sm:text-5xl">{hero.title}</h1>
          <p class="max-w-xl text-base leading-relaxed text-muted">{hero.description}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={ctas.hero.primary.href}
            class="flex items-center gap-2 rounded bg-accent px-5 py-2.5 font-mono text-sm font-medium text-on-accent transition-opacity hover:opacity-95"
          >
            {ctas.hero.primary.label}
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a
            href={ctas.hero.secondary.href}
            class="flex items-center gap-2 rounded border border-outline px-5 py-2.5 font-mono text-sm text-fg transition-colors hover:border-accent"
          >
            <Icon name="lucide:blocks" class="size-4 text-muted" aria-hidden="true" />
            {ctas.hero.secondary.label}
          </a>
        </div>
      </div>
      <div class="lg:col-span-6">
        <TerminalMock />
      </div>
    </div>
  </Section>

  {featured.length > 0 && (
    <Section>
      <SectionHeader
        eyebrow={t('integrations.eyebrow')}
        title={t('integrations.title')}
        description={t('integrations.description')}
        id="featured-integrations"
      >
        <a
          href={path('/integrations')}
          class="inline-flex items-center gap-1.5 self-start rounded border border-hairline bg-elevated px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-muted transition-colors hover:text-fg md:self-auto"
        >
          {t('integrations.count', { count: integrations.length })}
          <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
        </a>
      </SectionHeader>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-labelledby="featured-integrations">
        {featured.map(integration => (
          <IntegrationCard integration={integration} />
        ))}
      </ul>
    </Section>
  )}

  <Section id="quickstart">
    <SectionHeader
      eyebrow={t('quickstart.eyebrow')}
      title={t('quickstart.title')}
      description={t('quickstart.descriptionHome')}
    />
    <InstallTabs id="home" />
  </Section>

  <Section last>
    <CtaBox />
  </Section>

  <CopyStatus />
</Layout>

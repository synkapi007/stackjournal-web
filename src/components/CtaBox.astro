---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../i18n/context';
import { getCtas } from '../lib/ctas';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { locale } = getI18n(Astro.currentLocale);
const { box } = getCtas(locale, import.meta.env.BASE_URL);
const {
  eyebrow = box.eyebrow,
  title = box.title,
  body = box.body,
  primaryHref = box.primary.href,
  primaryLabel = box.primary.label,
  secondaryHref = box.secondary.href,
  secondaryLabel = box.secondary.label,
} = Astro.props;
---

<div class="flex flex-col items-start justify-between gap-8 rounded border border-hairline bg-raised p-8 sm:p-10 md:flex-row md:items-center">
  <div class="max-w-xl space-y-3">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="font-serif text-2xl text-fg sm:text-3xl">{title}</h2>
    <p class="text-sm leading-relaxed text-muted">{body}</p>
  </div>
  <div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
    <a
      href={primaryHref}
      class="flex items-center justify-center gap-2 rounded bg-accent px-5 py-2.5 font-mono text-xs font-semibold whitespace-nowrap text-on-accent transition-opacity hover:opacity-95"
    >
      <Icon name="simple-icons:github" class="size-3.5" aria-hidden="true" />
      {primaryLabel}
    </a>
    <a
      href={secondaryHref}
      class="flex items-center justify-center rounded border border-outline px-5 py-2.5 font-mono text-xs whitespace-nowrap text-fg transition-colors hover:border-accent"
    >
      {secondaryLabel}
    </a>
  </div>
</div>

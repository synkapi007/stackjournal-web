---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../i18n/context';
import type { UiKey } from '../i18n/ui';
import type { Swatch } from '../lib/palette';

interface Props {
  swatch: Swatch;
}

const { swatch } = Astro.props;
const { t } = getI18n(Astro.currentLocale);
const description = t(`role.${swatch.role}` as UiKey);
---

<li>
  <button
    type="button"
    data-copy={swatch.hex}
    class="group w-full rounded border border-hairline bg-raised p-3 text-left transition-colors hover:border-accent"
  >
    <span class="sr-only">{t('install.copy')}</span>
    <span
      class="mb-2.5 block h-14 w-full rounded border border-hairline"
      style={`background-color:${swatch.hex}`}
    ></span>
    <span class="flex items-center justify-between font-mono text-xs text-fg">
      <span>{swatch.role}</span>
      <Icon
        name="lucide:copy"
        class="size-3 text-faint opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
        aria-hidden="true"
      />
    </span>
    <span class="block font-mono text-[11px] text-faint">{swatch.hex}</span>
    <span class="mt-1 block text-[10px] text-muted">{description}</span>
  </button>
</li>

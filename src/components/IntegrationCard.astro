---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../i18n/context';
import type { UiKey } from '../i18n/ui';
import type { Integration } from '../lib/integrations';

interface Props {
  integration: Integration;
}

const { integration } = Astro.props;
const { t, path } = getI18n(Astro.currentLocale);
---

<li data-integration={`${integration.name} ${integration.slug} ${integration.category}`.toLowerCase()}>
  <a
    href={path(`/integrations/${integration.slug}`)}
    class="group flex h-full flex-col justify-between gap-6 rounded border border-hairline bg-raised p-5 transition-colors duration-150 hover:border-accent focus-visible:border-accent"
  >
    <span class="flex items-start justify-between gap-4">
      <span class="font-mono text-sm font-semibold text-fg transition-colors group-hover:text-accent">
        {integration.name}
      </span>
      <Icon name={integration.icon} class="size-7 shrink-0 text-accent" aria-hidden="true" />
    </span>
    <span class="flex flex-col gap-2">
      <span class="text-sm text-muted">{integration.description}</span>
      <span class="font-mono text-[11px] text-faint">{t(`category.${integration.category}` as UiKey)}</span>
    </span>
  </a>
</li>

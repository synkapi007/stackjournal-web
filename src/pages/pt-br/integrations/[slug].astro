---
import { getIntegrations, type Integration } from '../../../lib/integrations';
import IntegrationDetail from '../../../views/IntegrationDetail.astro';

export function getStaticPaths() {
  return getIntegrations('pt-br').map(integration => ({
    params: { slug: integration.slug },
    props: { integration },
  }));
}

interface Props {
  integration: Integration;
}

const { integration } = Astro.props;
---

<IntegrationDetail integration={integration} />
